<form class="{{cssClass}} flexcol" autocomplete="off">
  
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile" src="{{item.img}}" data-action="editImage" title="Click to change image" alt="{{item.name}}"/>
    
    <div class="header-details flexcol">
      <h1 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Gear Name"/>
      </h1>
      
      <div class="item-subtitle">
        <i class="fas fa-toolbox"></i> Gear
      </div>
    </div>
  </header>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    
    <h2>Gear Properties</h2>
    
    <div class="form-group">
      <label>Gear Type</label>
      <select name="system.gearType">
        {{#select system.gearType}}
        <option value="adventuring">Adventuring Gear</option>
        <option value="tools">Tools</option>
        <option value="container">Container</option>
        <option value="food">Food & Drink</option>
        <option value="light">Light Source</option>
        <option value="miscellaneous">Miscellaneous</option>
        {{/select}}
      </select>
      <p class="hint">Category of gear item</p>
    </div>

    <h3>Physical Properties</h3>
    
    <div class="form-row">
      <div class="form-group">
        <label>Inventory Slots</label>
        <input type="number" name="system.slots" value="{{system.slots}}" data-dtype="Number" min="0" max="10"/>
        <p class="hint">Space taken in inventory</p>
      </div>
      
      <div class="form-group">
        <label>Quantity</label>
        <input type="number" name="system.quantity" value="{{system.quantity}}" data-dtype="Number" min="1"/>
        <p class="hint">Number of items</p>
      </div>
    </div>

    <h3>Value</h3>
    
    <div class="form-row">
      <div class="form-group">
        <label><i class="fas fa-coins"></i> Gold</label>
        <input type="number" name="system.price.gold" value="{{system.price.gold}}" data-dtype="Number" min="0"/>
      </div>
      
      <div class="form-group">
        <label><i class="fas fa-coins"></i> Silver</label>
        <input type="number" name="system.price.silver" value="{{system.price.silver}}" data-dtype="Number" min="0"/>
      </div>
      
      <div class="form-group">
        <label><i class="fas fa-coins"></i> Copper</label>
        <input type="number" name="system.price.copper" value="{{system.price.copper}}" data-dtype="Number" min="0"/>
      </div>
    </div>

    <h3>Special Properties</h3>
    
    <div class="form-group">
      <label>
        <input type="checkbox" name="system.consumable" {{checked system.consumable}}/>
        Consumable (single use)
      </label>
    </div>
    
    <div class="form-group">
      <label>
        <input type="checkbox" name="system.container" {{checked system.container}}/>
        Container (holds other items)
      </label>
    </div>
    
    {{#if system.container}}
    <div class="form-group">
      <label>Container Capacity (slots)</label>
      <input type="number" name="system.capacity" value="{{system.capacity}}" data-dtype="Number" min="1"/>
      <p class="hint">How many slots this container holds</p>
    </div>
    {{/if}}

    <h3>Description</h3>
    <div class="editor-container">
      <div class="editor-content" data-edit="system.description">
        {{{enrichedDescription}}}
      </div>
      {{#if editable}}
      <button type="button" class="editor-edit" data-action="toggleEditor" data-target="system.description">
        <i class="fas fa-edit"></i> Edit
      </button>
      {{/if}}
    </div>

  </section>
</form>
